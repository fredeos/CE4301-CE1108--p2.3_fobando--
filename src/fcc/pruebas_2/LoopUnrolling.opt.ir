globals:
  resultado_loop_unrolling

func procesar_bloques(bloques) -> int
  t1 = 0
  total = t1
  t2 = 0
  i = t2
  t3 = 0
  i = t3
L1:
  t4 = 6
  if i < t4 goto L2
  goto L3
L2:
  t6 = bloques[i]
  t7 = 2
  t8 = t6 * t7
  dobles[i] = t8
  t9 = 1
  t10 = i + t9
  i = t10
  t4_u1 = 6
  if i < t4_u1 goto L4
  goto L3
L4:
  t6_u1 = bloques[i]
  t7_u1 = 2
  t8_u1 = t6_u1 * t7_u1
  dobles[i] = t8_u1
  t9_u1 = 1
  t10_u1 = i + t9_u1
  i = t10_u1
  t4_u2 = 6
  if i < t4_u2 goto L5
  goto L3
L5:
  t6_u2 = bloques[i]
  t7_u2 = 2
  t8_u2 = t6_u2 * t7_u2
  dobles[i] = t8_u2
  t9_u2 = 1
  t10_u2 = i + t9_u2
  i = t10_u2
  goto L1
L3:
  t11 = 0
  t12 = dobles[t11]
  t13 = 1
  t14 = dobles[t13]
  t15 = t12 + t14
  t16 = 2
  t17 = dobles[t16]
  t18 = t15 + t17
  total = t18
  t19 = 3
  t20 = dobles[t19]
  t21 = total + t20
  total = t21
  t22 = 4
  t23 = dobles[t22]
  t24 = total + t23
  total = t24
  t25 = 5
  t26 = dobles[t25]
  t27 = total + t26
  total = t27
  return total

func main() -> int
  t1 = 10
  t2 = 0
  bloques[t2] = t1
  t3 = 20
  t4 = 1
  bloques[t4] = t3
  t5 = 30
  t6 = 2
  bloques[t6] = t5
  t7 = 5
  t8 = 3
  bloques[t8] = t7
  t9 = 15
  t10 = 4
  bloques[t10] = t9
  t11 = 25
  t12 = 5
  bloques[t12] = t11
  param bloques
  t13 = call procesar_bloques, 1
  resultado_loop_unrolling = t13
  return resultado_loop_unrolling
