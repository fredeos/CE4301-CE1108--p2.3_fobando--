func factorial(a) -> int
  t1_1 = 1
  resultado = t1_1
  t2_1 = 1
  i = t2_1
  t3_1 = 15
  m = t3_1
  t4_1 = 16
  t5_1 = m + t4_1
  m = t5_1
L1:
  if i <= a goto L2
  goto L3
L2:
  t7_1 = resultado * i
  resultado = t7_1
  t8_1 = 1
  t9_1 = i + t8_1
  i = t9_1
  goto L1
L3:
  return resultado

func main() -> int
  t1_1 = 8
  param t1_1
  t2_1 = call factorial, 1
  return t2_1
