func factorial(a) -> int
  t1 = 1
  t2 = 1
  t3 = 15
  t4 = 16
  resultado = t1
  i = t2
  m = t3
  t5 = m + t4
  m = t5
L1:
  if i <= a goto L2
  goto L3
L2:
  t8 = 12
  t9 = 1
  t7 = resultado * i
  t10 = i + t9
  resultado = t7
  m = t8
  i = t10
  goto L1
L3:
  return resultado

func main() -> int
  t1 = 8
  param t1
  t2 = call factorial, 1
  return t2
